# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database & Redis ---
DATABASE_URL=postgresql://dispatchly:dispatchly@localhost:5432/dispatchly?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=dispatchly-local-secret-2026-random-key
# --- Auth ---

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Ethereal SMTP (all outgoing mail is fake/test-inbox only) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
MAIL_ACCOUNT_POOL_SIZE=4

# --- Worker & delivery controls ---
# Set to "false" when running worker.ts as its own process/container, so the
# combined server.ts doesn't ALSO spin up an in-process worker for the same queue.
ENABLE_INLINE_WORKER=true
WORKER_CONCURRENCY=5
MIN_SPACING_MS=2000
MAX_HOURLY_CAP=200
MAX_RECIPIENTS_PER_CAMPAIGN=10000
STALE_CLAIM_MS=300000
